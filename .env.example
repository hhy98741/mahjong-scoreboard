# Copy to .env and fill in — .env is gitignored, never commit real values.
# Bun loads .env automatically for `bun run`, so no extra setup is needed.

# Used by tests/e2e/demo.mjs (bun run demo) to log into the site and play
# through a batch of demo games in a visible browser, with a pause after
# each action so you can watch it happen. See tests/e2e/demo.mjs header.
MJSB_DEMO_BASE=https://example.com
MJSB_DEMO_USER=demo
MJSB_DEMO_PASS=change-me

# Optional overrides:
# MJSB_DEMO_HEADLESS=1        # run with no visible browser window (default: headed)
# MJSB_DEMO_DELAY_MS=1000     # pause after each action, in ms (default: 1000)
